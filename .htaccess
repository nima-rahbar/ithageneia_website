# ==============================================================================
# Apache Configuration for ithageneia.nimarahbar.com
# Optimized for Showcase Landing Page & Protected Audio Streaming
# ==============================================================================

# 1. CORS Headers (Allows Android App, WebView & External Clients to stream audio)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header set Access-Control-Allow-Headers "Range, Accept-Ranges, Content-Type, Origin, User-Agent, Referer"
    Header set Access-Control-Expose-Headers "Content-Range, Content-Length, Accept-Ranges"
</IfModule>

DirectoryIndex index.php index.html

# 2. Legacy WordPress & HTML Redirections
# Redirects legacy WordPress theme assets, admin paths, core files, and legacy .html URLs (HTTP 301)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 2a. Redirect legacy .html endpoints to active .php files
    RewriteRule ^index\.html$ / [R=301,L]
    RewriteRule ^privacy_policy\.html$ /privacy_policy.php [R=301,L]

    # 2b. Legacy theme assets: /wp-content/themes/nima-studio/*
    RewriteRule ^wp-content/themes/nima-studio(/.*)?$ / [R=301,L]

    # 2c. Legacy WordPress admin: /wp-admin/*
    RewriteRule ^wp-admin(/.*)?$ / [R=301,L]

    # 2d. Additional legacy WordPress paths (content, plugins, includes, login)
    RewriteRule ^wp-content(/.*)?$ / [R=301,L]
    RewriteRule ^wp-includes(/.*)?$ / [R=301,L]
    RewriteRule ^wp-login\.php$ / [R=301,L]
    RewriteRule ^xmlrpc\.php$ / [R=301,L]

    # --------------------------------------------------------------------------
    # 3. Hotlink & Direct Browser Protection for Audio Files (.mp3)
    # Blocks direct URL bar navigation, downloads, and external hotlinking.
    # --------------------------------------------------------------------------
    # Allow if referer matches authorized app environments or your domain
    RewriteCond %{HTTP_REFERER} ^https?://appassets\.androidplatform\.net [NC,OR]
    RewriteCond %{HTTP_REFERER} ^https?://([a-zA-Z0-9-]+\.)?nimarahbar\.com [NC,OR]
    RewriteCond %{HTTP_REFERER} ^(capacitor|ionic|http://localhost|https://localhost) [NC]
    RewriteRule \.(mp3|ogg|m4a|wav)$ - [L]

    # Otherwise block any audio requests that didn't match the whitelist
    RewriteRule \.(mp3|ogg|m4a|wav)$ - [F,NC,L]
</IfModule>

# 4. Fallback Apache FilesMatch Protection (Works even if mod_rewrite is disabled)
<FilesMatch "\.(mp3|ogg|m4a|wav)$">
    <IfModule mod_authz_core.c>
        # Require valid referer
        SetEnvIfNoCase Referer "^https?://appassets\.androidplatform\.net" allowed_audio
        SetEnvIfNoCase Referer "^https?://([a-zA-Z0-9-]+\.)?nimarahbar\.com" allowed_audio
        SetEnvIfNoCase Referer "^(capacitor|ionic|http://localhost|https://localhost)" allowed_audio
        Require env allowed_audio
    </IfModule>
</FilesMatch>

# 5. Byte-Range Streaming & Caching for Audio Files (.mp3)
<IfModule mod_headers.c>
    <FilesMatch "\.(mp3|ogg|m4a|wav)$">
        Header set Accept-Ranges "bytes"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 6. Browser Caching for Fast Loading
# Dynamic PHP and HTML files are configured with no-cache so updates propagate immediately through reverse proxies and CDNs
<FilesMatch "\.(php|html|htm)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </IfModule>
</FilesMatch>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 2 days"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/json "access plus 1 month"
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType text/xml "access plus 1 day"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType audio/mpeg "access plus 1 year"
</IfModule>

# 7. Gzip Compression for Fast Page Loads
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml text/css application/javascript application/json
</IfModule>

# 8. UTF-8 Character Encoding
AddDefaultCharset UTF-8

# 9. MIME Types (Ensure proper application/xml content-type for Google Search Console)
<IfModule mod_mime.c>
    AddType application/xml .xml
    AddType image/webp .webp
</IfModule>

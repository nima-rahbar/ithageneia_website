# ==============================================================================
# Apache Configuration for ithageneia.nimarahbar.com
# Optimized for Showcase Landing Page & Protected Audio Streaming
# ==============================================================================

# 1. CORS Headers (Allows Android App, WebView & External Clients to stream audio)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header set Access-Control-Allow-Headers "Range, Accept-Ranges, Content-Type, Origin, User-Agent, Referer"
    Header set Access-Control-Expose-Headers "Content-Range, Content-Length, Accept-Ranges"
</IfModule>

# 2. Hotlink & Direct Browser Protection for Audio Files (.mp3)
# Blocks direct URL bar navigation, downloads, and external hotlinking.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow if referer matches authorized app environments or your domain
    RewriteCond %{HTTP_REFERER} ^https?://appassets\.androidplatform\.net [NC,OR]
    RewriteCond %{HTTP_REFERER} ^https?://([a-zA-Z0-9-]+\.)?nimarahbar\.com [NC,OR]
    RewriteCond %{HTTP_REFERER} ^(capacitor|ionic|http://localhost|https://localhost) [NC]
    RewriteRule \.(mp3|ogg|m4a|wav)$ - [L]

    # Otherwise block any audio requests that didn't match the whitelist
    RewriteRule \.(mp3|ogg|m4a|wav)$ - [F,NC,L]
</IfModule>

# 3. Fallback Apache FilesMatch Protection (Works even if mod_rewrite is disabled)
<FilesMatch "\.(mp3|ogg|m4a|wav)$">
    <IfModule mod_authz_core.c>
        # Require valid referer
        SetEnvIfNoCase Referer "^https?://appassets\.androidplatform\.net" allowed_audio
        SetEnvIfNoCase Referer "^https?://([a-zA-Z0-9-]+\.)?nimarahbar\.com" allowed_audio
        SetEnvIfNoCase Referer "^(capacitor|ionic|http://localhost|https://localhost)" allowed_audio
        Require env allowed_audio
    </IfModule>
</FilesMatch>

# 4. Byte-Range Streaming & Caching for Audio Files (.mp3)
<IfModule mod_headers.c>
    <FilesMatch "\.(mp3|ogg|m4a|wav)$">
        Header set Accept-Ranges "bytes"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 5. Browser Caching for Fast Loading
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 2 days"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/json "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType audio/mpeg "access plus 1 year"
</IfModule>

# 6. Gzip Compression for Fast Page Loads
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# 7. UTF-8 Character Encoding
AddDefaultCharset UTF-8
